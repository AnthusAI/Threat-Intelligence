{
  "name": "threat-intelligence",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "papyrus-app sync && next dev --port 3001",
    "build": "papyrus-app sync && next build",
    "start": "next start",
    "typecheck": "papyrus-app sync && tsc --noEmit",
    "test": "npm run test:blog-defense-graph && npm run test:threat-intelligence-pictograms && npm run test:video-script",
    "test:blog-defense-graph": "node publication/tests/test-blog-defense-graph.cjs",
    "test:threat-intelligence-pictograms": "node publication/tests/test-pictograms.cjs",
    "test:video-script": "node publication/tests/test-video-script.cjs"
  },
  "dependencies": {
    "@anthusai/papyrus": "1.0.0-next.37",
    "@aws-amplify/backend": "^1.22.0",
    "@aws-amplify/backend-cli": "^1.8.2",
    "@aws-amplify/seed": "^1.1.2",
    "aws-cdk-lib": "^2.257.0",
    "constructs": "^10.4.2",
    "next": "^15.5.18",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/react": "^19.2.0",
    "typescript": "^5.9.0"
  },
  "overrides": {
    "@aws-cdk/toolkit-lib": "1.32.0",
    "@opentelemetry/core": "2.11.0",
    "zod": "$zod"
  }
}
