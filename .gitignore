# <<< papyrus-app sync

# papyrus-app sync writes generated shims under app/ and lists them above unescaped, so bracketed route paths
# never match. Ignore app/ wholesale and re-include only the routes this publication owns.
/app/*
!/app/posts/
!/app/archive/
!/app/settings/
!/app/\[year\]/
/app/\[year\]/\[month\]/\[day\]/*
!/app/\[year\]/\[month\]/\[day\]/page.tsx
!/app/\[year\]/\[month\]/\[day\]/\[articleSlug\]/
!/app/\[year\]/\[month\]/\[day\]/section/
